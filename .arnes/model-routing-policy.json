{
  "$schema": "https://arnes.dev/schemas/model-routing-policy-v1.json",
  "version": "1.1.0",
  "purpose": "Politica declarativa de preferencia y fallback por agente. El router resuelve estos aliases contra el catalogo vivo; este archivo no contiene IDs de proveedores.",
  "resolution_mode": "catalog_backed_aliases",
  "model_capabilities": {
    "qwen3_8_max": {
      "display_name": "Qwen3.8 Max",
      "capability": "agentic_orchestration"
    },
    "gpt_5_6_luna": {
      "display_name": "GPT-5.6 Luna",
      "capability": "reasoning_value"
    },
    "deepseek_v4_flash": {
      "display_name": "DeepSeek V4 Flash",
      "capability": "volume_execution"
    },
    "minimax_m3": {
      "display_name": "MiniMax M3",
      "capability": "efficient_execution"
    }
  },
  "provider_budget_defaults": {
    "strategy": "soft_cap_percent",
    "period": "weekly",
    "caps_percent_by_provider": {
      "tokenrouter": 30,
      "nvidia": 70
    },
    "on_cap_reached": "deprioritize_provider_unless_no_healthy_fallback",
    "note": "Los limites son objetivos de distribucion, no una afirmacion de cuota del proveedor. Estrategia 2026-08-05: DeepSeek V4 Flash = workhorse 75% de requests para estirar cuota OpenCode Go todo el mes."
  },
  "agents": {
    "atlas": { "preference_order": ["qwen3_8_max", "gpt_5_6_luna", "deepseek_v4_flash", "minimax_m3"] },
    "vivi": { "preference_order": ["gpt_5_6_luna", "qwen3_8_max", "deepseek_v4_flash", "minimax_m3"] },
    "eiko": { "preference_order": ["deepseek_v4_flash", "minimax_m3", "gpt_5_6_luna", "qwen3_8_max"] },
    "ansem": { "preference_order": ["deepseek_v4_flash", "gpt_5_6_luna", "qwen3_8_max", "minimax_m3"] },
    "eremez": { "preference_order": ["deepseek_v4_flash", "minimax_m3", "gpt_5_6_luna", "qwen3_8_max"] },
    "amarant": { "preference_order": ["gpt_5_6_luna", "qwen3_8_max", "deepseek_v4_flash", "minimax_m3"] },
    "kuja": { "preference_order": ["deepseek_v4_flash", "gpt_5_6_luna", "minimax_m3", "qwen3_8_max"] },
    "auron": { "preference_order": ["deepseek_v4_flash", "gpt_5_6_luna", "qwen3_8_max", "minimax_m3"] },
    "bran": { "preference_order": ["gpt_5_6_luna", "qwen3_8_max", "deepseek_v4_flash", "minimax_m3"] },
    "quina": { "preference_order": ["deepseek_v4_flash", "minimax_m3", "gpt_5_6_luna", "qwen3_8_max"] },
    "varys": { "preference_order": ["gpt_5_6_luna", "qwen3_8_max", "deepseek_v4_flash", "minimax_m3"] },
    "tywin": { "preference_order": ["deepseek_v4_flash", "gpt_5_6_luna", "qwen3_8_max", "minimax_m3"] },
    "sam": { "preference_order": ["gpt_5_6_luna", "qwen3_8_max", "deepseek_v4_flash", "minimax_m3"] }
  },
  "validation": {
    "required_agents": ["atlas", "vivi", "eiko", "ansem", "eremez", "amarant", "kuja", "auron", "bran", "quina", "varys", "tywin", "sam"],
    "preference_order_length": 4,
    "unique_capabilities_per_agent": true,
    "unknown_capability": "reject",
    "missing_catalog_match": "skip_capability_and_continue_to_next_healthy_fallback",
    "legacy_files": "read_only; this policy does not replace model-chain.json or model-assignments.json until router integration"
  }
}
